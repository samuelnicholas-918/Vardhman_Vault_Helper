# Vardhman Vault Progress Dashboard — environment variables.
# RESOLVED 6 Sept 2026 (PROJECT_RULES.md §3.5): these point at Vardhman
# Vault's own STAGING Supabase project — not prod, not a dedicated third
# project. The `build_status` table's migration lives in the main
# vardhman-vault repo, not here.

NEXT_PUBLIC_SUPABASE_URL=          # same value as vardhman-vault's staging project
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # same value as vardhman-vault's staging project

DASHBOARD_PASSWORD=

# For src/app/api/narrate/route.ts (added 7 Sept 2026) — the plain-language
# narration layer. Requires a Supabase Database Webhook configured to POST
# to this route on build_status INSERT (Supabase dashboard: Database →
# Webhooks). NARRATE_WEBHOOK_SECRET must match the custom header value you
# set on that webhook — pick any long random string, put it in both places.
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=         # same value as vardhman-vault's staging project — needed to write the summary back
NARRATE_WEBHOOK_SECRET=
